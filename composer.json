{
	"name": "wapplersystems/oidc-connect",
	"type": "typo3-cms-extension",
	"description": "OpenID Connect login for TYPO3 v14: per-site configuration via Site Settings, discovery, PKCE, ID-token validation, RP-initiated and back-channel logout, silent SSO, backend login and Keycloak client provisioning.",
	"keywords": ["TYPO3", "extension", "OpenID Connect", "OIDC", "SSO", "Keycloak", "login"],
	"homepage": "https://github.com/WapplerSystems/t3-oidc-connect",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Sven Wappler",
			"email": "typo3@wappler.systems",
			"homepage": "https://wappler.systems",
			"role": "Developer"
		}
	],
	"support": {
		"issues": "https://github.com/WapplerSystems/t3-oidc-connect/issues",
		"source": "https://github.com/WapplerSystems/t3-oidc-connect"
	},
	"require": {
		"php": "^8.2",
		"ext-json": "*",
		"ext-openssl": "*",
		"firebase/php-jwt": "^6.10 || ^7.0",
		"typo3/cms-backend": "^14.0",
		"typo3/cms-core": "^14.0",
		"typo3/cms-frontend": "^14.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.5 || ^12.0",
		"typo3/testing-framework": "^9.0"
	},
	"autoload": {
		"psr-4": {
			"WapplerSystems\\OidcConnect\\": "Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"WapplerSystems\\OidcConnect\\Tests\\": "Tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"vendor-dir": ".Build/vendor",
		"bin-dir": ".Build/bin"
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "oidc_connect",
			"web-dir": ".Build/public"
		}
	}
}
