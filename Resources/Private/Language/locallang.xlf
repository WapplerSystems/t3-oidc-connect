			<trans-unit id="error.provider_unavailable"><source>The sign-in service is currently not available.</source></trans-unit>
			<trans-unit id="error.state_invalid"><source>The sign-in took too long or was started in another browser. Please try again.</source></trans-unit>
			<trans-unit id="error.provider_error"><source>The sign-in service refused the request.</source></trans-unit>
			<trans-unit id="error.login_required"><source>Please sign in.</source></trans-unit>
			<trans-unit id="button.login"><source>Log in</source></trans-unit>
			<trans-unit id="button.logout"><source>Log out</source></trans-unit>
