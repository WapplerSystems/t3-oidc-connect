<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" datatype="plaintext" original="EXT:oidc_connect/Configuration/Sets/OidcConnect/labels.xlf" product-name="oidc_connect">
        <header/>
        <body>
            <trans-unit id="categories.oidcConnect">
                <source>OIDC Connect</source>
            </trans-unit>
            <trans-unit id="categories.oidcConnect.connection">
                <source>Connection</source>
            </trans-unit>
            <trans-unit id="categories.oidcConnect.auth">
                <source>Authentication behaviour</source>
            </trans-unit>
            <trans-unit id="categories.oidcConnect.users">
                <source>Frontend user provisioning</source>
            </trans-unit>
            <trans-unit id="categories.oidcConnect.ui">
                <source>User interface</source>
            </trans-unit>
            <trans-unit id="categories.oidcConnect.backend">
                <source>Backend login</source>
            </trans-unit>
            <trans-unit id="categories.oidcConnect.routes">
                <source>Routes</source>
            </trans-unit>
            <trans-unit id="categories.oidcConnect.endpoints">
                <source>Endpoint overrides</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.issuer">
                <source>Issuer URL</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.issuer">
                <source>Base URL of the OpenID Connect provider. TYPO3 resolves the discovery document from &lt;issuer&gt;/.well-known/openid-configuration unless endpoint overrides are set.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.clientId">
                <source>Client ID</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.clientId">
                <source>Client identifier registered at the provider. Required for the authorization code flow.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.clientSecretEnv">
                <source>Client secret environment variable</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.clientSecretEnv">
                <source>Name of the environment variable that holds the client secret. Leave empty to use OIDC_CONNECT_&lt;SITE&gt;_CLIENT_SECRET. The secret itself is never stored in site settings.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.scopes">
                <source>Scopes</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.scopes">
                <source>Scopes requested during authorization. Defaults to openid, email and profile; at least openid is required for OIDC.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.tokenEndpointAuthMethod">
                <source>Token endpoint auth method</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.tokenEndpointAuthMethod">
                <source>How the client authenticates at the token endpoint. auto uses client_secret_basic when the provider advertises it, otherwise client_secret_post; none is only for public clients.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.tokenEndpointAuthMethod.enum.auto">
                <source>Auto-detect</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.tokenEndpointAuthMethod.enum.client_secret_basic">
                <source>Client secret basic</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.tokenEndpointAuthMethod.enum.client_secret_post">
                <source>Client secret post</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.tokenEndpointAuthMethod.enum.none">
                <source>None (public client)</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.auth.enableFrontend">
                <source>Enable frontend login</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.auth.enableFrontend">
                <source>Enables OIDC login for frontend users of this site. Default: on.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.auth.useUserinfo">
                <source>Use userinfo endpoint</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.auth.useUserinfo">
                <source>Fetches additional claims from the userinfo endpoint after token exchange. The sub claim must match the ID token.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.auth.backchannelLogout">
                <source>Back-channel logout</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.auth.backchannelLogout">
                <source>Accepts OpenID back-channel logout requests at the configured route. Affected sessions end on their next request.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.auth.silentSso">
                <source>Silent SSO</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.auth.silentSso">
                <source>Checks anonymous visitors once per interval with prompt=none and logs them in silently if a provider session exists. Bots and non-HTML requests are skipped.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.auth.silentSsoInterval">
                <source>Silent SSO interval</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.auth.silentSsoInterval">
                <source>Number of seconds between silent SSO checks for anonymous visitors. Default: 3600.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.auth.languageParameter">
                <source>Language parameter</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.auth.languageParameter">
                <source>Comma-separated authorize parameter names that receive the two-letter site language. For Keycloak use ui_locales,kc_locale. Default: ui_locales.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.auth.idpHint">
                <source>Identity provider hint</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.auth.idpHint">
                <source>Value for the Keycloak kc_idp_hint parameter to jump directly to a brokered identity provider. Leave empty to show the provider's login page.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.auth.clockSkew">
                <source>Clock skew</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.auth.clockSkew">
                <source>Tolerance in seconds when validating exp, iat and nbf claims. Default: 60.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.auth.allowedSigningAlgorithms">
                <source>Allowed signing algorithms</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.auth.allowedSigningAlgorithms">
                <source>Signing algorithms TYPO3 accepts for ID and logout tokens; intersected with what the provider announces. Symmetric (HS*) and unsigned tokens are always rejected. Default: RS256, RS384, RS512, PS256, ES256, ES384.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.users.storagePid">
                <source>Frontend user storage page</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.users.storagePid">
                <source>Page ID where newly created frontend users are stored. Default: 0 (not set).</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.users.defaultGroups">
                <source>Default groups</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.users.defaultGroups">
                <source>Comma-separated frontend user group UIDs assigned to newly created users. Default: empty.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.users.mustExistLocally">
                <source>Require existing frontend user</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.users.mustExistLocally">
                <source>When enabled, no new frontend users are created; only existing accounts are linked. Default: off.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.users.reEnableDisabled">
                <source>Re-enable disabled users</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.users.reEnableDisabled">
                <source>Re-enables a disabled frontend user on successful OIDC login. Default: off.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.users.undelete">
                <source>Undelete deleted users</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.users.undelete">
                <source>Undeletes a deleted frontend user on successful OIDC login. Default: off.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.users.linkByField">
                <source>Link by field</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.users.linkByField">
                <source>Links an existing, not yet linked frontend user whose field matches the claim on first login. For email, email_verified must be true when linkRequireVerifiedEmail is enabled.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.users.linkByField.enum.">
                <source>Not set</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.users.linkByField.enum.username">
                <source>Username</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.users.linkByField.enum.email">
                <source>Email</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.users.linkByClaim">
                <source>Link by claim</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.users.linkByClaim">
                <source>Claim used to match the field selected in linkByField. Default: email.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.users.linkRequireVerifiedEmail">
                <source>Require verified email</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.users.linkRequireVerifiedEmail">
                <source>Only links by email when the ID token or userinfo contains email_verified=true. Default: on.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.users.groupsClaim">
                <source>Groups claim</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.users.groupsClaim">
                <source>Claim (dotted path, e.g. realm_access.roles or groups) whose values are mapped through the YAML group mapping. Leave empty to disable group mapping.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.ui.afterLoginPageId">
                <source>After-login page</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.ui.afterLoginPageId">
                <source>Page ID used as fallback redirect after a successful login. Default: 0 (not set).</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.ui.logoutRedirectPageId">
                <source>Logout redirect page</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.ui.logoutRedirectPageId">
                <source>Page ID to redirect to after logout. Default: 0 (not set).</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.ui.errorPageId">
                <source>Error page</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.ui.errorPageId">
                <source>Page ID shown for login errors; receives the query parameter oidc_error=&lt;code&gt;. Default: 0 (not set).</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.backend.enable">
                <source>Enable backend login</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.backend.enable">
                <source>Enables OIDC login for the TYPO3 backend. Uses the site selected in the extension configuration (backendSite). Default: off.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.backend.createUsers">
                <source>Create backend users</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.backend.createUsers">
                <source>Creates backend users on first OIDC login. Default: off.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.backend.defaultGroups">
                <source>Default backend groups</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.backend.defaultGroups">
                <source>Comma-separated backend user group UIDs assigned to newly created backend users. Default: empty.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.backend.linkByField">
                <source>Backend link by field</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.backend.linkByField">
                <source>Links an existing, not yet linked backend user whose field matches the claim on first login. Default: email.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.backend.linkByField.enum.">
                <source>Not set</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.backend.linkByField.enum.username">
                <source>Username</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.backend.linkByField.enum.email">
                <source>Email</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.backend.groupsClaim">
                <source>Backend groups claim</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.backend.groupsClaim">
                <source>Claim (dotted path) whose values are mapped through the YAML backend group mapping. Leave empty to disable group mapping.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.routes.authorize">
                <source>Authorize route</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.routes.authorize">
                <source>Path below the site base that starts the login (optional ?redirect=&lt;return URL&gt;). Default: /oauth_authorize.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.routes.callback">
                <source>Callback route</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.routes.callback">
                <source>Path below the site base that receives the authorization response. Must match a redirect URI registered at the provider. Default: /oauth_callback.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.routes.logout">
                <source>Logout route</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.routes.logout">
                <source>Path below the site base that initiates logout. Default: /oauth_logout.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.routes.backchannelLogout">
                <source>Back-channel logout route</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.routes.backchannelLogout">
                <source>Path below the site base that accepts OpenID back-channel logout requests. Default: /oauth_backchannel_logout.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.endpoints.authorization">
                <source>Authorization endpoint</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.endpoints.authorization">
                <source>Optional override for the authorization endpoint. Normally resolved from the issuer discovery document. Default: empty.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.endpoints.token">
                <source>Token endpoint</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.endpoints.token">
                <source>Optional override for the token endpoint. Normally resolved from the issuer discovery document. Default: empty.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.endpoints.userinfo">
                <source>Userinfo endpoint</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.endpoints.userinfo">
                <source>Optional override for the userinfo endpoint. Normally resolved from the issuer discovery document. Default: empty.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.endpoints.endSession">
                <source>End session endpoint</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.endpoints.endSession">
                <source>Optional override for the end session endpoint. Normally resolved from the issuer discovery document. Default: empty.</source>
            </trans-unit>
            <trans-unit id="settings.oidcConnect.endpoints.jwks">
                <source>JWKS endpoint</source>
            </trans-unit>
            <trans-unit id="settings.description.oidcConnect.endpoints.jwks">
                <source>Optional override for the JSON Web Key Set endpoint. Normally resolved from the issuer discovery document. Default: empty.</source>
            </trans-unit>
        </body>
    </file>
</xliff>
